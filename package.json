{
  "name": "github-prs",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "dev": "vite",
    "build": "vite build",
    "package:extension": "bun run build && bun scripts/package-extension.ts",
    "validate:marketplace": "bun scripts/validate-marketplace.ts",
    "version": "changeset version && bun scripts/sync-manifest-version.ts && oxfmt manifest.json package.json CHANGELOG.md",
    "release": "bun run package:extension && bun run validate:marketplace",
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "gate": "concurrently -n type,lint,fmt,test,build -c blue,yellow,magenta,cyan,green \"bun run typecheck\" \"bun run lint\" \"bun run fmt:check\" \"bun run test\" \"bun run build\"",
    "prepare": "lefthook install && effect-tsgo patch"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.23",
    "effect": "4.1.4",
    "solid-js": "2.0.0-rc.23"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "0.70.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "concurrently": "^10.0.7",
    "effect-bun-test": "0.5.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-plugin-effect": "^0.32.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "3.0.0-next.27"
  }
}
