{
  "name": "github-prs",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package:extension": "bun run build && bun scripts/package-extension.ts",
    "validate:marketplace": "bun scripts/validate-marketplace.ts",
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "gate": "concurrently -n type,lint,fmt,test,build -c blue,yellow,magenta,cyan,green \"bun run typecheck\" \"bun run lint\" \"bun run fmt:check\" \"bun run test\" \"bun run build\"",
    "prepare": "lefthook install && effect-tsgo patch"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-beta.19",
    "effect": "4.0.0-beta.98",
    "solid-js": "2.0.0-beta.19"
  },
  "devDependencies": {
    "@effect/tsgo": "0.23.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "concurrently": "^10.0.3",
    "effect-bun-test": "0.3.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-plugin-effect": "0.2.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-solid": "3.0.0-next.12"
  }
}
